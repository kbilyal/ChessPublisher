    oldPrimary.innerHTML=`<div id="cpDirectionalCloudPanel" class="cp-directional-panel"><div class="cp-directional-head"><div><div class="cp-directional-eyebrow">ONLINE & CLOUD</div><div id="cpDirectionalTournamentName" class="cp-directional-name">—</div></div><div id="cpDirectionalStatusBadge" class="cp-directional-status">○ Offline</div></div><div id="cpDirectionalStatusMessage" class="cp-directional-message">Cloud status not checked yet.</div><div class="cp-directional-main-actions"><button id="cpDirectionalPullBtn" class="primary" type="button">↓ Pull Cloud → Desktop</button><button id="cpDirectionalPushBtn" class="primary" type="button">↑ Push Desktop → Cloud</button></div><div class="cp-directional-secondary-actions"><button id="cpDirectionalCheckBtn" type="button">Check Cloud Status</button><button id="cpDirectionalResolveBtn" class="danger" type="button" hidden>Resolve Conflict</button><button id="cpDirectionalOpenWebBtn" type="button">Open in Web</button></div><div class="cp-directional-meta"><span>Desktop revision base: <b id="cpDirectionalBaseRevision">r0</b></span><span>Cloud revision: <b id="cpDirectionalRemoteRevision">r0</b></span><span>Last Pull: <b id="cpDirectionalLastPull">—</b></span><span>Last Push: <b id="cpDirectionalLastPush">—</b></span></div><div class="cp-directional-local-note"><b>Autosave ON = local autosave only.</b> It never performs Pull and never overwrites Cloud.</div></div>`;
    const auto=document.getElementById("cloudAutoSync");if(auto){auto.checked=false;auto.disabled=true;const label=auto.closest("label");if(label)label.style.display="none";}
    const syncAll=document.getElementById("cloudSyncAllBtn");if(syncAll)syncAll.style.display="none";
    const autoStatus=document.getElementById("cloudAutoSyncStatus");if(autoStatus)autoStatus.textContent="Automatic Cloud synchronization is OFF. Desktop Autosave remains local only.";
    document.getElementById("cpDirectionalPullBtn").onclick=()=>foreground("Pulling Cloud → Desktop…",pullCloudToDesktop);
    document.getElementById("cpDirectionalPushBtn").onclick=()=>foreground("Pushing Desktop → Cloud…",pushDesktopToCloud);
    document.getElementById("cpDirectionalCheckBtn").onclick=()=>foreground("Checking Cloud status…",()=>checkCloudStatus({quiet:false}));
    document.getElementById("cpDirectionalResolveBtn").onclick=()=>foreground("Resolving field conflicts…",resolveConflictUi);
    document.getElementById("cpDirectionalOpenWebBtn").onclick=()=>{let id="";try{id=text(currentRecord().tournament?.cloud?.cloudTournamentId);}catch(_){ }const url=id?`${WEB_APP_URL}?cloudTournamentId=${encodeURIComponent(id)}`:WEB_APP_URL;window.open(url,"_blank","noopener,noreferrer");};
    installPublishGuards();render();
    setTimeout(()=>checkCloudStatus({quiet:true}).catch(()=>{}),150);
    return true;
  }

  function installStyles(){
    if(document.getElementById("cpDirectionalCloudStyle"))return;
    const style=document.createElement("style");style.id="cpDirectionalCloudStyle";style.textContent=`
      .cp-directional-panel{padding:2px}.cp-directional-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.cp-directional-eyebrow{font-size:10px;letter-spacing:.08em;font-weight:800;color:#586675}.cp-directional-name{font-size:17px;font-weight:800;margin-top:2px}.cp-directional-status{padding:7px 12px;border:1px solid #cbd5df;border-radius:999px;font-weight:800;font-size:12px;background:#f5f7f9}.cp-directional-status.status-in_sync{background:#edf7ed;border-color:#9fd29f;color:#107c10}.cp-directional-status.status-local_changes{background:#eef6ff;border-color:#9bc6ea;color:#0f5e9c}.cp-directional-status.status-remote_changes{background:#fff8e5;border-color:#e4c86d;color:#8a5a00}.cp-directional-status.status-conflict{background:#fff0f0;border-color:#e19b9b;color:#9b1c1c}.cp-directional-message{margin:8px 0;padding:7px 9px;background:#f8fafc;border:1px solid #d7dee6;border-radius:6px;font-size:11px}.cp-directional-main-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:10px 0}.cp-directional-main-actions button{min-height:42px;font-weight:800;font-size:13px}.cp-directional-secondary-actions{display:flex;gap:8px;flex-wrap:wrap}.cp-directional-secondary-actions button{min-height:31px}.cp-directional-meta{display:grid;grid-template-columns:repeat(4,minmax(120px,1fr));gap:6px;margin-top:10px;font-size:11px}.cp-directional-meta span{background:#fff;border:1px solid #dbe1e7;border-radius:5px;padding:6px 7px}.cp-directional-local-note{margin-top:8px;padding:7px 9px;border-left:3px solid #0f6cbd;background:#f5f9fd;font-size:11px}.cp-directional-conflict-modal{display:none;position:fixed;inset:0;z-index:30000;background:rgba(0,0,0,.18);align-items:center;justify-content:center}.cp-directional-conflict-modal.open{display:flex}.cp-directional-conflict-window{width:min(920px,calc(100vw - 40px));max-height:calc(100vh - 60px);background:#f4f4f4;border:1px solid #68737e;box-shadow:0 18px 55px rgba(0,0,0,.38);display:flex;flex-direction:column}.cp-directional-conflict-title{background:#8b1f1f;color:#fff;padding:10px 13px;font-weight:800}.cp-directional-conflict-body{padding:12px;overflow:auto}.cp-conflict-card{border:1px solid #c8cfd6;background:#fff;padding:9px;margin:9px 0}.cp-conflict-cols{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:7px}.cp-conflict-cols>div{border:1px solid #d7dde3;padding:8px}.cp-conflict-cols span{font-weight:800}.cp-conflict-cols pre{white-space:pre-wrap;max-height:180px;overflow:auto;background:#f7f8fa;padding:7px;border:1px solid #e0e4e8}.cp-conflict-cols button.chosen{outline:3px solid #0f6cbd;background:#eaf4ff}.cp-directional-conflict-footer{display:flex;justify-content:flex-end;gap:8px;padding:10px 12px;border-top:1px solid #ccd2d8;background:#e9ecef}@media(max-width:760px){.cp-directional-main-actions{grid-template-columns:1fr}.cp-directional-meta{grid-template-columns:1fr 1fr}.cp-conflict-cols{grid-template-columns:1fr}}
    `;document.head.appendChild(style);
  }

  window.ChessPublisherDirectionalCloudSyncInternals=Object.freeze({
    stableCanonicalize,stableStringify,sanitizeSecrets,portableTournament,contentObject,fingerprintPayload,
    buildPortableSnapshot,extractPortableTournament,restoreInstallationLocalFields,classifyThreeWay,threeWayMerge,setResolvedPath,
    chooseInternalId,FINGERPRINT_SCHEMA
  });
  window.cpCloudCheckStatus=checkCloudStatus;
  window.cpCloudPullToDesktop=pullCloudToDesktop;
